#!/bin/sh
set -e

# Resolve symlinks so packaged installs work: both the .deb and the Homebrew
# formula expose efsql as a symlink into the release tree, and RELEASE_ROOT is
# derived from this script's real location.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
RELEASE_ROOT="$(dirname "$(dirname "$SELF")")"
RELEASE_VSN="$(awk '{print $2}' "$RELEASE_ROOT/releases/start_erl.data")"
RELEASE_COOKIE="$(cat "$RELEASE_ROOT/releases/COOKIE")"

export RELEASE_ROOT
export RELEASE_VSN
export RELEASE_COOKIE
export RELEASE_SYS_CONFIG="$RELEASE_ROOT/releases/$RELEASE_VSN/sys"
export RELEASE_BOOT_SCRIPTS="$RELEASE_ROOT/releases/$RELEASE_VSN"
export RELEASE_LIB="$RELEASE_ROOT/lib"
export RELEASE_VM_ARGS="$RELEASE_ROOT/releases/$RELEASE_VSN/vm.args"
export RELEASE_PROG="$SELF"

usage() {
  echo "Usage: efsql [-C cluster_file] [--storage-id id] [--debug]"
  echo ""
  echo "Options:"
  echo "  -C, --cluster-file PATH   Path to fdb.cluster file"
  echo "      --storage-id ID       FoundationDB storage ID"
  echo "      --debug               Print the computed Ecto query before each result"
  echo "      --no-tui              Use the line-based REPL instead of the TUI"
  echo "      --check               Verify the FoundationDB client library loads"
  echo "  -V, --version             Show the version"
  echo "  -h, --help                Show this help"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -C|--cluster-file) export FDB_CLUSTER_FILE="$2"; shift 2;;
    --storage-id) export EFSQL_STORAGE_ID="$2"; shift 2;;
    --debug) export EFSQL_DEBUG="true"; shift;;
    --no-tui) export EFSQL_NO_TUI="true"; shift;;
    --check) EFSQL_CHECK="true"; shift;;
    -V|--version) echo "efsql $RELEASE_VSN"; exit 0;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown flag: $1" >&2; usage >&2; exit 1;;
  esac
done

# --check boots just far enough to load the erlfdb NIF, which dlopens the
# system libfdb_c. It is the fastest way to tell a packaging problem (missing
# or too-old FoundationDB client) apart from an application problem.
if [ "$EFSQL_CHECK" = "true" ]; then
  exec "$RELEASE_BOOT_SCRIPTS/elixir" \
    --cookie "$RELEASE_COOKIE" \
    --erl-config "$RELEASE_SYS_CONFIG" \
    --boot "$RELEASE_BOOT_SCRIPTS/start_clean" \
    --boot-var RELEASE_LIB "$RELEASE_LIB" \
    --vm-args "$RELEASE_VM_ARGS" \
    --eval '{:ok, _} = Application.ensure_all_started(:erlfdb); IO.puts("efsql #{System.get_env("RELEASE_VSN")}: FoundationDB client OK")'
fi

# +Bi: ignore break signals so Ctrl-C in the raw-mode TUI cannot drop the
# node into the BREAK menu mid-frame
exec "$RELEASE_BOOT_SCRIPTS/elixir" \
  --erl "+Bi" \
  --cookie "$RELEASE_COOKIE" \
  --erl-config "$RELEASE_SYS_CONFIG" \
  --boot "$RELEASE_BOOT_SCRIPTS/start_clean" \
  --boot-var RELEASE_LIB "$RELEASE_LIB" \
  --vm-args "$RELEASE_VM_ARGS" \
  --eval "Application.ensure_all_started(:efsql); Efsql.Cli.run()" \
  --no-halt
